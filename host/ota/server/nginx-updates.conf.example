server {
    listen 80;
    listen [::]:80;
    server_name updates.kmatzen.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name updates.kmatzen.com;

    ssl_certificate /etc/letsencrypt/live/updates.kmatzen.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/updates.kmatzen.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /srv/www/updates.kmatzen.com;
    autoindex off;
    add_header X-Content-Type-Options nosniff always;

    location = /millennium/stable/manifest.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location = /millennium/stable/manifest.json.sig {
        default_type application/octet-stream;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location /millennium/releases/ {
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
        limit_except GET HEAD { deny all; }
    }

    location / { return 404; }
}
