[Unit]
Description=Millennium Tools Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The daemon starts offline and lets SIP reconnect when networking becomes
# available. Waiting on a public ICMP endpoint made boot depend on 8.8.8.8.
ExecStart=/usr/local/bin/millennium-daemon --config /etc/millennium/daemon.conf
Restart=on-failure
RestartSec=2
WorkingDirectory=/var/lib/millennium
StandardInput=null
StandardOutput=journal
StandardError=journal
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-alsa rw
DeviceAllow=/dev/ttyACM0 rw
DeviceAllow=/dev/ttyACM1 rw
DeviceAllow=/dev/ttyACM2 rw
DeviceAllow=/dev/ttyACM3 rw
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
UMask=0077
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
ReadWritePaths=/var/lib/millennium /var/log/millennium
# Capabilities for the non-root daemon user (User= comes from the install-time
# daemon.service.d/override.conf):
#   CAP_SYS_NICE + CAP_IPC_LOCK / LimitRTPRIO + LimitMEMLOCK — real-time audio
#     scheduling and mlock for the ALSA threads
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
CapabilityBoundingSet=CAP_SYS_NICE CAP_IPC_LOCK
LimitRTPRIO=99
LimitMEMLOCK=64M

[Install]
WantedBy=default.target
