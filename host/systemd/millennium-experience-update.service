[Unit]
Description=Check and safely activate signed Millennium experiences
After=network-online.target daemon.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/millennium-experience check
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/millennium/content
